<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Verified Android App Link for auth callbacks (email confirmation and
              password recovery).

              This REPLACES the previous `voxfit://` custom-scheme filter, which was a
              real account-takeover path: custom schemes are first-come-claimed, so any
              other installed app could register `voxfit://`, receive the recovery
              intent, and read the access_token + refresh_token out of it. `autoVerify`
              makes Android check https://voxfit.amitpile.com/.well-known/assetlinks.json
              at install time and hand these URLs only to an app signed with a listed
              certificate — an ownership proof a custom scheme has no equivalent of.

              If verification ever fails (assetlinks.json missing, wrong Content-Type, or
              a fingerprint mismatch after a signing-key change), the link degrades
              gracefully: it opens in the browser and the user completes the reset in the
              web app instead. Broken-looking, but not insecure.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="voxfit.amitpile.com" android:pathPrefix="/auth" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
</manifest>
