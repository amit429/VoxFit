{
  "name": "voxfit",
  "version": "1.0.0",
  "description": "VoxFit — voice-first workout and diet logging for Android and mobile web.",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:open": "ng serve --open",
    "build": "ng build",
    "build:dev": "ng build --configuration=development",
    "prebuild:prod": "node scripts/generate-prod-env.js",
    "build:prod": "ng build --configuration=production",
    "watch": "ng build --watch --configuration=development",
    "test": "ng test",
    "lint": "ng lint",
    "cap:copy:android": "cap copy android",
    "cap:sync": "cap sync android",
    "cap:sync:all": "cap sync",
    "cap:open:android": "cap open android",
    "android:prepare:dev": "npm run build:dev && cap sync android",
    "android:prepare:prod": "npm run build:prod && cap sync android",
    "android:run:dev": "ionic capacitor run android --configuration=development",
    "android:run:dev:steps": "npm run android:prepare:dev && cap run android --no-sync",
    "android:run:prod": "ionic capacitor run android --configuration=production",
    "android:run:prod:steps": "npm run android:prepare:prod && cap run android --no-sync",
    "android:live:dev": "ionic capacitor run android -l --external --configuration=development"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.26",
    "@angular/common": "20.3.26",
    "@angular/compiler": "20.3.26",
    "@angular/core": "20.3.26",
    "@angular/forms": "20.3.26",
    "@angular/platform-browser": "20.3.26",
    "@angular/platform-browser-dynamic": "20.3.26",
    "@angular/router": "20.3.26",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "8.4.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.4.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/status-bar": "8.0.3",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@ionic/angular": "^8.0.0",
    "@supabase/supabase-js": "^2.105.4",
    "ionicons": "^7.0.0",
    "patch-package": "^8.0.1",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.2.4",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.0.0",
    "@angular-eslint/builder": "^20.0.0",
    "@angular-eslint/eslint-plugin": "^20.0.0",
    "@angular-eslint/eslint-plugin-template": "^20.0.0",
    "@angular-eslint/schematics": "^20.0.0",
    "@angular-eslint/template-parser": "^20.0.0",
    "@angular/cli": "^20.3.26",
    "@angular/compiler-cli": "20.3.26",
    "@angular/language-service": "20.3.26",
    "@capacitor/cli": "8.4.2",
    "@ionic/angular-toolkit": "^12.0.0",
    "@ionic/cli": "^7.2.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/jasmine": "~5.1.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.16.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^48.2.1",
    "eslint-plugin-prefer-arrow": "1.2.2",
    "jasmine-core": "~5.1.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.14",
    "typescript": "~5.9.0"
  }
}
